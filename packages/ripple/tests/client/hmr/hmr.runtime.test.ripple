import { describe, it, expect } from 'vitest';
import { hmr, HMR } from 'ripple/internal/client';
import { flushSync } from 'ripple';

describe('hmr runtime', () => {
	it('wrapper has HMR symbol key with fn, current, update', () => {
		component A() {
			<div>A</div>
		}

		const wrapper = hmr(A);

		expect(wrapper[HMR]).toBeDefined();
		expect(wrapper[HMR].fn).toBe(A);
		expect('current' in wrapper[HMR]).toBe(true);
		expect(typeof wrapper[HMR].update).toBe('function');
	});

	it('wrapper runs the component when mounted', () => {
		component B() {
			<div id="hmr-b">B</div>
		}

		const wrapper = hmr(B);
		render(wrapper);

		expect(container.querySelector('#hmr-b')).toBeTruthy();
		expect(container.querySelector('#hmr-b').textContent).toBe('B');
	});

	it('update() swaps component after flush', () => {
		component First() {
			<div id="hmr-first">First</div>
		}
		component Second() {
			<div id="hmr-second">Second</div>
		}

		const wrapper = hmr(First);
		render(wrapper);

		expect(container.querySelector('#hmr-first')).toBeTruthy();
		expect(container.querySelector('#hmr-second')).toBeFalsy();

		const incoming = {
			[HMR]: {
				fn: Second,
				current: null,
			},
		};
		wrapper[HMR].update(incoming);
		flushSync();

		expect(container.querySelector('#hmr-second')).toBeTruthy();
		expect(container.querySelector('#hmr-second').textContent).toBe('Second');
	});
});
