import { describe, it, expect } from 'vitest';
import { compile } from 'ripple/compiler';

describe('compiler > HMR', () => {
	it('injects HMR block when hmr: true and named default export', () => {
		const source = `export default component App() {
  <div>Hi</div>
}`;
		const result = compile(source, 'App.ripple', { hmr: true });

		expect(result.js.code).toContain('import.meta.hot');
		expect(result.js.code).toContain('App = _$.hmr(App)');
		expect(result.js.code).toContain('_$.HMR');
		expect(result.js.code).toContain('update(module.default)');
		expect(result.js.code).toContain('export default App');
	});

	it('does not inject HMR block when hmr: false', () => {
		const source = `export default component App() {
  <div>Hi</div>
}`;
		const result = compile(source, 'App.ripple', { hmr: false });

		expect(result.js.code).not.toContain('_$.hmr');
		expect(result.js.code).not.toContain('import.meta.hot');
	});

	it('injects HMR block with correct name for different component name', () => {
		const source = `export default component Page() {
  <span>Page</span>
}`;
		const result = compile(source, 'Page.ripple', { hmr: true });

		expect(result.js.code).toContain('Page = _$.hmr(Page)');
		expect(result.js.code).toContain('export default Page');
	});
});
